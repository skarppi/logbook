{
  "name": "opentx-logbook",
  "private": true,
  "version": "1.0.0",
  "description": "Flight logbook from OpenTX logs",
  "scripts": {
    "clean": "rimraf server/dist",
    "build": "pnpm run clean && pnpm -r run build",
    "production": "NODE_ENV=production node PORT=3000 ./server/dist/server/src/server.js",
    "dev": "pnpm -r --parallel run dev"
  },
  "keywords": [
    "typescript",
    "react",
    "starter-kit",
    "webpack",
    "fullstack",
    "express",
    "express4",
    "node"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/skarppi/logbook.git"
  },
  "license": "MIT",
  "author": "Juho Kolehmainen",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^2.7.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.1",
    "typescript": "^7.0.0"
  }
}
